{% include "macros/questions_table.jinja" %}

{% macro risk_itinerary(
    figure_ref = None,
    Item_spec = None,
    grid_ref = None
) %}
        It is unclear how the IBC is causing a public health and safety risk.
        {{figure_ref}} identifying the item {{Item_spec}} located at {{grid_ref}} fails to specify : 
        <ol>
            <li>
                nature of risk
            </li>
            <li>
                severity of risk
            </li>
            <li>
                statutory instrument or HSE reference to specified risks
            </li>
        </ol>
{% endmacro %}

{% macro text_quotation(
    quote_text = "",
    quote_reference = ""
)%}

    <div id="{{ quote_reference }}" class="legal-clause">
        <div class="legal-clause-ref">{{ quote_reference }}</div>
        <p>
            {{quote_text}}
        </p>
    </div>

{% endmacro %}

{% macro line_by_line_text_quotation(
    quote_text = [],
    first_line_number = 1,
    quote_reference = ""
)%}
    {% set ns = namespace(line_number=1) %}
    <div id="{{ quote_reference }}" class="legal-clause">
        <div class="legal-clause-ref">{{ quote_reference }}</div>
        <div>
            {% for line in quote_text %} 
                <p><i>[{{first_line_number + ns.line_number}}]</i>
                   {{line}}</p>
                <br>
                 {% set ns.line_number = ns.line_number + 1 %}
            {% endfor %}
        </div>
    </div>

{% endmacro %}

{% macro oscola_citation(
    authors=None,
    title=None,
    year=None,
    court=None,
    neutral_citation=None,
    reporter=None,
    volume=None,
    page=None,
    url=None,
    access_date=None,
    doc_type="case"
) %}
    <span class="oscola-citation">

        {# --- Authors / Parties --- #}
        {% if authors %}
            <span class="oscola-authors">{{ authors }}</span>
        {% endif %}

        {# --- Case title or Article title --- #}
        {% if title %}
            {% if doc_type == "case" %}
                <span class="oscola-title"><i>{{ title }}</i></span>
            {% else %}
                <span class="oscola-title">‘{{ title }}’</span>
            {% endif %}
        {% endif %}

        {# --- Year --- #}
        {% if year %}
            <span class="oscola-year">({{ year }})</span>
        {% endif %}

        {# --- Neutral citation (e.g. [2019] UKSC 12) --- #}
        {% if neutral_citation %}
            <span class="oscola-neutral">{{ neutral_citation }}</span>
        {% endif %}

        {# --- Reporter info --- #}
        {% if reporter %}
            <span class="oscola-reporter">
                {% if volume %}{{ volume }} {% endif %}
                {{ reporter }}
                {% if page %} {{ page }}{% endif %}
            </span>
        {% endif %}

        {# --- Court (if not already in neutral citation) --- #}
        {% if court %}
            <span class="oscola-court">({{ court }})</span>
        {% endif %}

        {# --- URL + Access date --- #}
        {% if url %}
            <span class="oscola-url">
                &lt;<a href="{{ url }}">{{ url }}</a>&gt;
            </span>
        {% endif %}
        {% if access_date %}
            <span class="oscola-access">accessed {{ access_date }}</span>
        {% endif %}
    </span>
{% endmacro %}

{# ---
Example use
{{ oscola_citation(
    authors="R v Smith",
    title="Smith",
    neutral_citation="[2020] EWCA Crim 100",
    court="CA",
    url="https://www.bailii.org/ew/cases/EWCA/Crim/2020/100.html",
    access_date="12 November 2025"
) }}
 --- #}